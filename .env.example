# ==============================================================================
# Companio Accessibility Suite — Vercel Environment Variables Template
# Copy these into your Vercel Project Settings:
# Project Settings -> Environment Variables
# ==============================================================================

# 1. Supabase Cloud Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# 2. AI Model & Vision Providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_key_here
OCR_SPACE_API_KEY=your_ocr_space_api_key_here

# 3. Application URL (Set this to your Vercel domain)
NEXT_PUBLIC_APP_URL=https://your-companio-app.vercel.app
