# Companio Accessibility Suite — Environment Variables
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.

# ────────────────────────────────────────────────────────────────────────────────
# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
# ────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# ────────────────────────────────────────────────────────────────────────────────
# AI & Vision Providers
# ────────────────────────────────────────────────────────────────────────────────
# Gemini 2.5 Flash (powers OCR, scene description, AI assistant, and prompt-based translation)
GEMINI_API_KEY=<your-gemini-api-key>

# Optional — free tier, no credit card required (25,000 requests/month). Get one at ocr.space/ocrapi.
# If left blank, a shared public demo key is used with lower limits.
OCR_SPACE_API_KEY=<your-ocr-space-api-key>

# Optional — only used as a last-resort fallback after Gemini and OCR.space.
# Requires a Google Cloud billing account; the app works fully without this key.
GOOGLE_CLOUD_VISION_API_KEY=<your-vision-api-key>

# Free tier, no credit card required — get one at console.groq.com.
# Used as fallback for the assistant/translate routes and as the primary
# engine for live-caption transcription.
GROQ_API_KEY=<your-groq-api-key>

# ────────────────────────────────────────────────────────────────────────────────
# Optional: Python FastAPI microservice (Tier 3 AI service)
# Only needed if running services/ai_service/main.py locally.
# ────────────────────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000

# ────────────────────────────────────────────────────────────────────────────────
# Optional: Node.js API Gateway (Tier 2 gateway)
# Only needed if running server/gateway.js separately.
# ────────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
GATEWAY_TARGET=http://127.0.0.1:8000
