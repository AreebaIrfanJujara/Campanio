# Companio Accessibility Suite — Environment Variables
# Copy this file to .env.local and fill in your credentials.
# NEVER commit .env.local to version control.

# ────────────────────────────────────────────────────────────────────────────────
# Supabase — https://supabase.com/dashboard/project/<your-project>/settings/api
# ────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-secret-key>

# ────────────────────────────────────────────────────────────────────────────────
# Google Cloud — https://console.cloud.google.com/apis/credentials
# Each key below should be restricted to only its corresponding API.
# ────────────────────────────────────────────────────────────────────────────────
# Cloud Vision API (OCR + scene description + currency recognition)
GOOGLE_CLOUD_VISION_API_KEY=<your-vision-api-key>

# Cloud Speech-to-Text API (server-side STT + diarization)
GOOGLE_CLOUD_STT_API_KEY=<your-stt-api-key>

# Cloud Text-to-Speech API (Neural2 voice synthesis)
GOOGLE_CLOUD_TTS_API_KEY=<your-tts-api-key>

# Cloud Translation API v2
GOOGLE_CLOUD_TRANSLATE_API_KEY=<your-translate-api-key>

# Gemini 2.5 Flash (AI accessibility assistant)
GOOGLE_GEMINI_API_KEY=<your-gemini-api-key>

# ────────────────────────────────────────────────────────────────────────────────
# Optional: Python FastAPI microservice (Tier 3 AI service)
# Only needed if running services/ai_service/main.py locally.
# ────────────────────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://127.0.0.1:8000

# ────────────────────────────────────────────────────────────────────────────────
# Optional: Node.js API Gateway (Tier 2 gateway)
# Only needed if running server/gateway.js separately.
# ────────────────────────────────────────────────────────────────────────────────
GATEWAY_PORT=4000
GATEWAY_TARGET=http://127.0.0.1:8000
